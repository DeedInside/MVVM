<UserControl x:Class="MVVM.View.Contorls.ListItems.ItemProductControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MVVM.View.Contorls.ListItems"
             mc:Ignorable="d" 
             d:DesignHeight="260" d:DesignWidth="230">
    <Border BorderBrush="Black" BorderThickness="1"
        Margin="5" Padding="5">
        <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border Width="200" Height="200" BorderBrush="Black" BorderThickness="1"
                    Margin="0 0 0 5">
                <Image
               Source="{Binding ImagePath}"/>
            </Border>
            <TextBlock Text="{Binding Name}"/>
            <TextBlock>
            <Run Text="{Binding Price}"/>
            <Run Text="руб."/>
            <Run Text="{Binding Discont}"/>
            <Run Text="%"/>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
