<UserControl x:Class="MVVM.View.Contorls.AdminControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MVVM.View.Contorls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="White" FontSize="22">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <Menu DockPanel.Dock="Left">
                <MenuItem Header="файл" FontSize="22">
                    <MenuItem Header="выход" Command="{Binding ExitAuthCommand}"/>
                </MenuItem>
            </Menu>
            <StackPanel DockPanel.Dock="Right">
                <Label Content="123123123"/>
            </StackPanel>
            <StackPanel>
                
            </StackPanel>
        </DockPanel>
        <TabControl>
            <TabItem Header="Product">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
                        <TextBox Width="120" Text="поиск"/>
                        <ComboBox Width="120" Margin="5 0 5 0"/> <!--фильтрация-->
                        <ComboBox  Width="120"/> <!--сортировка-->
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="5">
                        <Button Content="Add" Margin="5" Padding="5" Width="100"/>
                        <Button Content="Remove" Margin="5" Padding="5" Width="100"/>
                        <Button Content="Edith" Margin="5" Padding="5" Width="100"/>
                    </StackPanel>
                    <Grid>
                        <ListBox />
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="User">
                
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
